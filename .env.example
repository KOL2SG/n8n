# n8n OIDC Configuration Example
# Copy this file to .env and fill in your OIDC provider details

# OIDC Provider Settings
N8N_OIDC_ISSUER_URL=https://your-oidc-provider.com
N8N_OIDC_CLIENT_ID=your-client-id-here
N8N_OIDC_CLIENT_SECRET=your-client-secret-here

# Optional: Override redirect URL if different from default
# N8N_OIDC_REDIRECT_URL=http://localhost:5678/rest/sso/oidc/callback

# Example configurations for popular OIDC providers:

# Google OAuth2
# N8N_OIDC_ISSUER_URL=https://accounts.google.com
# N8N_OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# N8N_OIDC_CLIENT_SECRET=your-google-client-secret

# Azure AD
# N8N_OIDC_ISSUER_URL=https://login.microsoftonline.com/your-tenant-id/v2.0
# N8N_OIDC_CLIENT_ID=your-azure-app-id
# N8N_OIDC_CLIENT_SECRET=your-azure-client-secret

# Keycloak
# N8N_OIDC_ISSUER_URL=https://your-keycloak-server.com/realms/your-realm
# N8N_OIDC_CLIENT_ID=your-keycloak-client-id
# N8N_OIDC_CLIENT_SECRET=your-keycloak-client-secret

# Auth0
# N8N_OIDC_ISSUER_URL=https://your-domain.auth0.com
# N8N_OIDC_CLIENT_ID=your-auth0-client-id
# N8N_OIDC_CLIENT_SECRET=your-auth0-client-secret
