ARG NODE_VERSION=22

# Multi-stage build for production
FROM node:${NODE_VERSION}-alpine AS base

# Install build dependencies
RUN apk add --no-cache \
    git \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev \
    librsvg-dev \
    pixman-dev \
    pkgconfig

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.12.1 --activate

# Set working directory
WORKDIR /app

# Copy package files for dependency installation
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY turbo.json ./
COPY patches/ ./patches/

# Copy all source code to resolve workspace dependencies
COPY . .

# Remove problematic langchain nodes package to avoid sqlite3 compilation issues
RUN rm -rf packages/@n8n/nodes-langchain

# Install dependencies - pnpm is required for workspace support
RUN pnpm install --frozen-lockfile --ignore-scripts

# Build the application
RUN pnpm build

# Production runtime stage
FROM node:${NODE_VERSION}-alpine AS runtime

# Install only essential runtime dependencies
RUN apk add --no-cache \
    cairo \
    jpeg \
    pango \
    giflib \
    librsvg \
    pixman \
    tini \
    su-exec \
    curl \
    openssl \
    ca-certificates

# Create node user if it doesn't exist
RUN if ! getent group node >/dev/null 2>&1; then \
        addgroup -g 1000 node; \
    fi && \
    if ! id node >/dev/null 2>&1; then \
        adduser -u 1000 -G node -s /bin/sh -D node; \
    fi

# Set working directory
WORKDIR /home/node/n8n

# Copy CLI package with all necessary files
COPY --from=base --chown=node:node /app/packages/cli/dist ./dist/
COPY --from=base --chown=node:node /app/packages/cli/bin ./bin/
COPY --from=base --chown=node:node /app/packages/cli/package.json ./package.json

# Copy the main node_modules for runtime dependencies
# This includes all external npm packages and workspace packages via pnpm links
COPY --from=base --chown=node:node /app/node_modules ./node_modules/

# Copy @n8n workspace packages with dist and package.json files
# Copy each @n8n package individually to avoid conflicts
COPY --from=base --chown=node:node /app/packages/@n8n/backend-common/dist ./node_modules/@n8n/backend-common/dist/
COPY --from=base --chown=node:node /app/packages/@n8n/backend-common/package.json ./node_modules/@n8n/backend-common/
COPY --from=base --chown=node:node /app/packages/@n8n/constants/dist ./node_modules/@n8n/constants/dist/
COPY --from=base --chown=node:node /app/packages/@n8n/constants/package.json ./node_modules/@n8n/constants/
COPY --from=base --chown=node:node /app/packages/@n8n/config/dist ./node_modules/@n8n/config/dist/
COPY --from=base --chown=node:node /app/packages/@n8n/config/package.json ./node_modules/@n8n/config/
COPY --from=base --chown=node:node /app/packages/@n8n/permissions/dist ./node_modules/@n8n/permissions/dist/
COPY --from=base --chown=node:node /app/packages/@n8n/permissions/package.json ./node_modules/@n8n/permissions/
COPY --from=base --chown=node:node /app/packages/@n8n/api-types/dist ./node_modules/@n8n/api-types/dist/
COPY --from=base --chown=node:node /app/packages/@n8n/api-types/package.json ./node_modules/@n8n/api-types/

# Copy core workspace packages with complete structure to ensure proper resolution
# These are the main packages referenced in CLI's package.json
COPY --from=base --chown=node:node /app/packages/core ./node_modules/n8n-core/
COPY --from=base --chown=node:node /app/packages/workflow ./node_modules/n8n-workflow/
COPY --from=base --chown=node:node /app/packages/nodes-base ./node_modules/n8n-nodes-base/
COPY --from=base --chown=node:node /app/packages/frontend/editor-ui ./node_modules/n8n-editor-ui/

# Create symlink and set permissions
RUN ln -sf /home/node/n8n/bin/n8n /usr/local/bin/n8n && \
    mkdir -p /home/node/.n8n

# Environment variables
ENV NODE_ENV=production
ENV N8N_USER_FOLDER=/home/node/.n8n
ENV N8N_HOST=0.0.0.0
ENV N8N_PORT=5678
ENV N8N_PROTOCOL=http
ENV N8N_LOG_LEVEL=info

# OIDC environment variables (disabled by default)
ENV N8N_SSO_OIDC_ENABLED=false
ENV N8N_OIDC_SCOPES="openid email profile"
ENV N8N_OIDC_JIT_PROVISIONING=true
ENV N8N_OIDC_REDIRECT_LOGIN_TO_SSO=false

# Expose port
EXPOSE 5678

# Switch to non-root user
USER node

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5678/healthz || exit 1

# Use tini as init system
ENTRYPOINT ["tini", "--"]

# Default command
CMD ["n8n", "start"]

# Labels
LABEL org.opencontainers.image.title="n8n Production Build" \
      org.opencontainers.image.description="n8n Workflow Automation with OIDC Support - Complete Dependencies" \
      org.opencontainers.image.source="https://github.com/n8n-io/n8n" \
      org.opencontainers.image.url="https://n8n.io" \
      org.opencontainers.image.vendor="n8n"
